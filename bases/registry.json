{
  "default": "fullstack",
  "bases": {
    "fullstack": {
      "path": "fullstack",
      "language": "dart+typescript",
      "description": "Hệ thống đầy đủ theo bố cục Now_me: <tên>_app Flutter (iOS + Android; core/ + features/<x>/data·domain·presentation, ApiClient tự làm mới token, đăng nhập), <tên>_server Dart Frog + PostgreSQL (/api/v1, routes mỏng, core/ + features/<x>/data·domain, db/migrations theo ngày, JWT access + refresh xoay vòng, lỗi chung, openapi.yaml), <tên>_web Next.js (public / member / admin, token trong cookie httpOnly), docker-compose",
      "platforms": [
        "ios",
        "android",
        "web"
      ],
      "exclude": [
        "project_app/build",
        "project_app/.dart_tool",
        "project_app/.idea",
        "project_app/app.iml",
        "project_app/ios/Pods",
        "project_app/android/.gradle",
        "project_app/.flutter-plugins-dependencies",
        "project_app/integration_test/.dart_tool",
        "project_server/.dart_tool",
        "project_server/.dart_frog",
        "project_server/build",
        "project_server/coverage",
        "project_server/.env",
        "project_web/node_modules",
        "project_web/.next",
        "project_web/next-env.d.ts",
        "project_web/tsconfig.tsbuildinfo",
        "project_web/coverage",
        "project_web/.env.local",
        ".env"
      ],
      "parts": [
        {
          "name": "app",
          "dir": "*_app",
          "marker": "pubspec.yaml",
          "requires": {
            "codegen": "build_runner"
          },
          "commands": {
            "setup": [
              "flutter",
              "pub",
              "get"
            ],
            "codegen": [
              "flutter",
              "pub",
              "run",
              "build_runner",
              "build"
            ],
            "format_check": [
              "dart",
              "format",
              "--output=none",
              "--set-exit-if-changed",
              "."
            ],
            "analyze": [
              "flutter",
              "analyze"
            ],
            "test": [
              "flutter",
              "test",
              "--reporter",
              "failures-only"
            ],
            "test_quick": [
              "flutter",
              "test",
              "--reporter",
              "failures-only",
              "--dart-define=DEVICE_MATRIX=quick"
            ],
            "store_check": [
              "dart",
              "run",
              "tool/store_check.dart"
            ],
            "integration": [
              "flutter",
              "test",
              "integration_test",
              "-d",
              "{ios_simulator}"
            ],
            "build_web": [
              "flutter",
              "build",
              "web"
            ],
            "build_android_release": [
              "flutter",
              "build",
              "appbundle",
              "--release",
              "--obfuscate",
              "--split-debug-info=build/symbols"
            ],
            "build_ios_release": [
              "flutter",
              "build",
              "ios",
              "--release",
              "--no-codesign",
              "--obfuscate",
              "--split-debug-info=build/symbols"
            ]
          },
          "fallbackDirs": [
            "app",
            "."
          ]
        },
        {
          "name": "server",
          "dir": "*_server",
          "marker": "pubspec.yaml",
          "requires": {
            "build": "dart_frog"
          },
          "commands": {
            "setup": [
              "dart",
              "pub",
              "get"
            ],
            "format_check": [
              "dart",
              "format",
              "--output=none",
              "--set-exit-if-changed",
              "."
            ],
            "analyze": [
              "dart",
              "analyze",
              "--fatal-infos"
            ],
            "test": [
              "dart",
              "test"
            ],
            "build": [
              "dart_frog",
              "build"
            ]
          }
        },
        {
          "name": "web",
          "dir": "*_web",
          "marker": "package.json",
          "commands": {
            "setup": [
              "npm",
              "install",
              "--no-audit",
              "--no-fund"
            ],
            "analyze": [
              "npm",
              "run",
              "typecheck"
            ],
            "test": [
              "npm",
              "test"
            ],
            "build": [
              "npm",
              "run",
              "build"
            ]
          },
          "fallbackDirs": [
            "web"
          ]
        },
        {
          "name": "be",
          "dir": "be",
          "marker": "package.json",
          "commands": {
            "setup": [
              "npm",
              "install",
              "--no-audit",
              "--no-fund"
            ],
            "codegen": [
              "npx",
              "prisma",
              "generate"
            ],
            "analyze": [
              "npm",
              "run",
              "typecheck"
            ],
            "test": [
              "npm",
              "test",
              "--",
              "--silent"
            ],
            "build": [
              "npm",
              "run",
              "build"
            ]
          }
        }
      ],
      "rename": {
        "from": "project",
        "files": [
          "docker-compose.yml",
          ".env.example",
          "README.md",
          "AGENTS.md",
          "project-status.md",
          "project_web/package.json",
          "project_web/README.md",
          "project_app/README.md"
        ]
      }
    }
  }
}
