#!/bin/sh
# Chạy lệnh của một phần ngay từ gốc project, không cần cd:
#   ./dev app flutter test      ./dev server dart test      ./dev web npm run build
# Phần → thư mục: app → *_app, server → *_server, web → *_web (project cũ: app/, web/, be/).
# Chỉ cho flutter / dart / dart_frog / npm / npx — agent được cấp quyền theo mẫu `./dev <phần> <công cụ> *`.
set -eu
if [ "$#" -lt 2 ]; then
  echo "Dùng: ./dev <app|server|web|be> <flutter|dart|dart_frog|npm|npx> [tham số...]" >&2
  exit 2
fi
part="$1"
shift
case "$part" in
  app | server | web | be) ;;
  *) echo "Phần không hợp lệ: $part (chỉ app, server, web, be)" >&2; exit 2 ;;
esac
case "$1" in
  flutter | dart | dart_frog | npm | npx) ;;
  *) echo "Công cụ không được phép: $1 (chỉ flutter, dart, dart_frog, npm, npx)" >&2; exit 2 ;;
esac
root="$(cd "$(dirname "$0")" && pwd)"
dir=""
for candidate in "$root"/*_"$part" "$root/$part"; do
  if [ -d "$candidate" ]; then
    dir="$candidate"
    break
  fi
done
if [ -z "$dir" ]; then
  echo "Không thấy thư mục của phần $part (*_$part hoặc $part/)" >&2
  exit 2
fi
cd "$dir"
exec "$@"
