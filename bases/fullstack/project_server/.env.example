# Sao thành .env cho máy dev — .env KHÔNG được commit (có bí mật thật).
APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://app:app@localhost:5432/app
# development dùng disable; database có SSL (staging / production / dịch vụ ngoài) dùng require.
DB_SSL_MODE=disable
# Chuỗi ngẫu nhiên dài ≥ 32 ký tự, mỗi môi trường một bộ khác nhau: openssl rand -base64 48
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Origin của web được gọi API (phân tách bằng dấu phẩy).
CORS_ORIGINS=http://localhost:3001
# Tài khoản admin tạo bởi `dart run tool/seed.dart` (chỉ development).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-mat-khau-nay
